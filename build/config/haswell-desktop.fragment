# ============================================================
#  Winux — DELTA de config do kernel p/ DESKTOP HASWELL
#  (Intel Core i7-4771, 4C/8T, GTX 1060 6GB, 24GB RAM)
#  Metodo: make defconfig (base sanada p/ desktop) + merge deste
#  fragmento + olddefconfig. tinyconfig NAO serve p/ sistema
#  Debian/systemd/XFCE completo (falta PRINTK/SYSFS/ELF/CGROUPS).
#  Objetivo: ALTO DESEMPENHO (governor performance, preempt,
#  march=haswell via KCFLAGS) com hardware desta maquina.
# ============================================================

# --- Plataforma x86-64 / SMP ---
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_X86_MPPARSE=y
CONFIG_GENERIC_CPU=y

# --- Otimizacao: desempenho, nao tamanho ---
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_KERNEL_XZ=y

# --- Modulos (DKMS p/ NVIDIA) ---
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y

# --- ACPI (tudo e enumerado por ACPI) ---
CONFIG_ACPI=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_HOTPLUG_CPU=y
CONFIG_ACPI_THERMAL=y

# --- PCI + MSI ---
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_QUIRKS=y

# --- Timers / relogio ---
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HPET_TIMER=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# --- Preempt: baixa latencia p/ desktop ---
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y

# --- CPU freq: DESEMPENHO fixo (alto desempenho) ---
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_INTEL_IDLE=y

# --- Microcode Intel ---
CONFIG_MICROCODE=y
CONFIG_MICROCODE_INTEL=y

# --- RTC ---
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y

# --- devtmpfs (udev) + firmware ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FW_LOADER=y

# --- Console / terminal ---
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y

# --- Framebuffer EFI (console de boot) ---
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# --- DRM (base; NOUVEAU off p/ nao conflitar com NVIDIA) ---
CONFIG_DRM=y
CONFIG_DRM_NOUVEAU=n

# --- Input ---
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y

# --- HID (USB) ---
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# --- Block / storage ---
CONFIG_BLOCK=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_LZ4=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y

# --- SATA (HDDs E:/F: + SSD Kingston) ---
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y

# --- NVMe (disco do Winux) ---
CONFIG_NVME=y

# --- Particoes ---
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y

# --- USB ---
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_STORAGE=y

# --- Rede (Realtek RTL8111/8169 e Intel I217V, comuns em ASUS H81/B85) ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000E=y

# --- Audio HD (Realtek ALC + HDMI da GTX) ---
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y

# --- Filesystems ---
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_XFS_FS=y
CONFIG_FUSE_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
CONFIG_NFS_FS=y

# --- I/O de alta performance ---
CONFIG_IO_URING=y

# --- UEFI ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# --- Live/overlay (ISO live-boot + persistencia) ---
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_ISO9660_FS=y
CONFIG_DEVPTS_FS=y

# --- NVMe builtin (root do Winux; initramfs nao depende de modulo) ---
CONFIG_BLK_DEV_NVME=y